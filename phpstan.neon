includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    typeAliases:
        RuleList: 'array<int, \Illuminate\Contracts\Validation\ValidationRule|\Stringable|array<mixed>|string>'
        Rules: 'array<string, RuleList>'

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
